{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "/gen/srv",
    "rootDir": "./",
    "allowJs": true,
    "inlineSources": true,
    "inlineSourceMap": true,
    "paths": {
      "@sap/cds": ["./node_modules/@cap-js/cds-types"],
      "#cds-models/*": ["./@cds-models/*"]
    },
    "types": ["node", "@cap-js/cds-types"]
  },
  "include": ["./srv"],
  "exclude": ["node_modules", "*.config.*", "gen", "dist"]
}
