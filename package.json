{
  "name": "product-supplier",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@sap/eslint-plugin-cds": "^4",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "cds-swagger-ui-express": "^0.11.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-serve",
    "deploy": "mbt build && (cf target || cf login) && cf deploy mta_archives/product-supplier_1.0.0.mtar",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "[development]": {
        "NorthWind": {
          "kind": "odata",
          "model": "srv/external/NorthWind",
          "credentials": {
            "url": "https://services.odata.org/v4/northwind/northwind.svc"
          }
        }
      },
      "[hybrid]": {
        "db": {
          "kind": "hana"
        }
      },
      "[production]": {
        "auth": {
          "kind": "mocked"
        },
        "NorthWind": {
          "kind": "odata",
          "model": "srv/external/NorthWind",
          "credentials": {
            "destination": "NorthWind"
          }
        }
      },
      "destinations": true
    }
  }
}
